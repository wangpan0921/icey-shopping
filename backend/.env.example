# ===== 基础 =====
NODE_ENV=development
PORT=4000

# 面向浏览器的站点地址（Stripe success_url / cancel_url 用）
PUBLIC_WEB_URL=http://localhost:3000

# 后端自身对外地址（webhook 需外网可达时填公网地址，本地联调用 stripe listen）
PUBLIC_API_URL=http://localhost:4000

# ===== 数据库 =====
# dev: SQLite 零依赖；prod: 换成 postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# ===== 支付渠道选择 =====
# mock   —— 不走任何真实渠道，测试环境零资质最快跑通
# stripe —— 走 Stripe（测试或生产取决于下面的 key 是 sk_test_ 还是 sk_live_）
PAYMENT_PROVIDER=mock

# ===== Stripe =====
# 测试：sk_test_xxx / whsec_xxx（Stripe 控制台直接领，不需要公司资质即可拿）
# 生产：sk_live_xxx / whsec_xxx（需要通过商户审核）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ===== CORS =====
# 允许前端访问的来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:3000
