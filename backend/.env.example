# ===== 基础 =====
NODE_ENV=development
PORT=4000

# 面向浏览器的站点地址（Stripe success_url / cancel_url 用；微信/支付宝也用）
PUBLIC_WEB_URL=http://localhost:3000

# 后端自身对外地址（webhook 需外网可达时填公网地址，本地联调用 stripe listen / 内网穿透）
PUBLIC_API_URL=http://localhost:4000

# ===== 数据库 =====
# dev: SQLite 零依赖；prod: 换成 postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# ===== 支付渠道选择 =====
# mock   —— 不走任何真实渠道，测试环境零资质最快跑通
# stripe —— 走 Stripe（境外，H5 PC/手机通用）
# wechat —— 走微信支付 v3（境内，支持 PC Native 二维码 / 手机 H5 / 微信内 JSAPI）
# alipay —— 走支付宝（境内，支持 PC Page / 手机 WAP）
# 规则：密钥为空时对应 adapter 会自动走 mock fallback，开发期无需真实商户资质即可跑完整条前端流程。
PAYMENT_PROVIDER=mock

# ===== Stripe =====
# 测试：sk_test_xxx / whsec_xxx（Stripe 控制台直接领，不需要公司资质）
# 生产：sk_live_xxx / whsec_xxx（需要通过商户审核）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ===== 微信支付 v3 =====
# 微信商户平台申请并开通 Native / H5 / JSAPI 产品后拿到以下信息
# WECHAT_PRIVATE_KEY 填一整段 PEM；多行密钥用字面 \n 换行，启动时会自动还原
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY=
WECHAT_SERIAL_NO=

# ===== 支付宝 =====
# 应用私钥 + 支付宝公钥（支付宝控制台生成）
# 沙箱环境把 ALIPAY_GATEWAY 换成 https://openapi.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ===== CORS =====
# 允许前端访问的来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:3000
